{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modulogical-engine-forge",
  "main": "src/main.py",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modulogical-engine-forge",
      "database_id": "28ae57bc-fdb7-4fdb-a327-1e68736be0b2"
    }
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
