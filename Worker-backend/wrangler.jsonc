{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modulogical-backend",
  "main": "src/main.py",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "INFERENCE_URL": "https://inference.modulogical.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modulogical-atlas",
      "database_id": "60274c4e-362a-4dda-ac2c-222ddbbe9e1a"
    },
    {"binding": "INFERENCE_NODE",
     "database_name": "inference-nodes",
     "database_id" : "380f9d27-bb93-4904-9b2f-4480ef79542e"}
  ],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
