{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "modulogical-backend",
  "main": "src/main.py",
  "compatibility_date": "2026-09-18",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "INFERENCE_URL": "https://inference.modulogical.com/generate"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modulogical-atlas",
      "database_id": "60274c4e-362a-4dda-ac2c-222ddbbe9e1a"
    }
  ]
}
