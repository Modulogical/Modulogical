{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",
  "name": "modulogical-marketplace",
  "main": "src/index.js",
  "compatibility_date": "2026-09-30",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modulogical-engine-forge-metadata",
      "database_id": "c925e334-268c-4f1c-a2f8-6f90b78d5d5f"
    },
    {
      "binding": "ATLAS",
      "database_name": "modulogical-atlas",
      "database_id": "60274c4e-362a-4dda-ac2c-222ddbbe9e9a"
    }
  ]
}