{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "modulogical-inference",
  "main": "src/index.js",
  "compatibility_date": "2026-09-18",
  "vars": {
    "INFERENCE_ORIGIN": "https://inference.modulogical.com"
  },
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  }
}
