{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modulogical-inference",
  "main": "src/backend.py",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["python_workers"],
  "routes": [
    { "pattern": "nodes.modulogical.com/*", "zone_name": "modulogical.com" },
    { "pattern": "inference.modulogical.com/*", "zone_name": "modulogical.com" }
  ],
  "observability": {"enabled": true},
  "d1_databases": [{
    "binding": "INFERENCE_NODE",
    "database_name": "inference-nodes",
    "database_id": "380f9d27-bb93-4904-9b2f-4480ef79542e"
  }]
}
