{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modulogical-inference",
  "main": "src/backend.py",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": ["python_workers"],
  "observability": {"enabled": true},
  "d1_databases": [{
    "binding": "DB",
    "database_name": "REPLACE_WITH_YOUR_EXISTING_D1_DATABASE_NAME",
    "database_id": "60274c4e-362a-4dda-ac2c-222ddbbe9e1a"
  }]
}
