{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "modulogical-admin-python",
  "main": "backend.py",
  "compatibility_date": "2026-09-30",
  "compatibility_flags": [
    "python_workers"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "modulogical-metadata",
      "database_id": "c925e334-268c-4f1c-a2f8-6f90b78d5d5f"
    },
    {
      "binding": "ATLAS",
      "database_name": "modulogical-atlas",
      "database_id": "60274c4e-362a-4dda-ac2c-222ddbbe9e9a"
    }
  ]
}
